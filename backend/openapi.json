          type: string
          format: byte
          readOnly: true
          nullable: true
        student:
          type: string
          format: uuid
      required:
      - date
      - details_enc
      - id
      - reason
      - student
    Enrollment:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
