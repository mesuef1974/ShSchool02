
{
  "name": "shahania-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tailwindcss -i ./src/css/app.css -o ../backend/static/css/app.css --watch & cp ./src/js/app.js ../backend/static/js/app.js",
    "build": "tailwindcss -i ./src/css/app.css -o ../backend/static/css/app.css --minify && cp ./src/js/app.js ../backend/static/js/app.js"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1"
  }
}
